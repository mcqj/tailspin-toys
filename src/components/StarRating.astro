---
import { clampRating } from '../lib/ratings';

interface Props {
    rating: number | null;
}

const { rating } = Astro.props;

type StarFill = 'full' | 'half' | 'empty';

const clampedRating = rating === null ? null : clampRating(rating);
const stars: StarFill[] = clampedRating === null
    ? []
    : Array.from({ length: 5 }, (_, index): StarFill => {
        const fill = clampedRating - index;
        if (fill >= 1) return 'full';
        if (fill >= 0.5) return 'half';
        return 'empty';
    });
---

{rating !== null && (
    <div class="flex items-center">
        <span
            class="inline-flex bg-blue-500/20 text-sm px-3 py-1 rounded-full"
            data-testid="game-rating"
            role="img"
            aria-label={`${clampedRating?.toFixed(1)} out of 5 stars`}
        >
            {stars.map((fill) => fill === 'half'
                ? (
                    <span class="relative inline-block text-slate-500" aria-hidden="true">
                        ☆
                        <span class="absolute inset-y-0 left-0 w-1/2 overflow-hidden text-yellow-400">★</span>
                    </span>
                )
                : <span class={fill === 'full' ? 'text-yellow-400' : 'text-slate-500'} aria-hidden="true">{fill === 'full' ? '★' : '☆'}</span>
            )}
        </span>
    </div>
)}
